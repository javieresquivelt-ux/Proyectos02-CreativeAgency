# ----------------------------------
# Dependencias
# ----------------------------------
node_modules/

# ----------------------------------
# Build de producción (Webpack)
# ----------------------------------
dist/

# ----------------------------------
# Caché de Webpack y herramientas
# ----------------------------------
.cache/
.webpack_cache/
.parcel-cache/

# ----------------------------------
# Variables de entorno y secretos
# ----------------------------------
.env
.env.local
.env.*.local

# ----------------------------------
# Logs
# ----------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ----------------------------------
# Sistemas operativos
# ----------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Windows
ehthumbs.db
Desktop.ini

# Linux
*~

# ----------------------------------
# Editores e IDEs
# ----------------------------------

# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml

# Vim / Emacs
*.swp
*.swo
*~

# ----------------------------------
# Cobertura de tests (si se añaden)
# ----------------------------------
coverage/
*.lcov

# ----------------------------------
# Archivos temporales
# ----------------------------------
tmp/
temp/
*.tmp
*.bak